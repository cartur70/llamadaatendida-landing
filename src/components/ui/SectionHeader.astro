---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { title, subtitle, align = 'center', class: className = '' } = Astro.props;

const alignmentClasses = {
  left: 'text-left',
  center: 'text-center mx-auto'
};
---

<div class={`mb-12 ${alignmentClasses[align]} ${className}`}>
  <h2 class="text-[28px] md:text-[40px] font-bold text-gray-900 mb-4">{title}</h2>
  {subtitle && (
    <p class="text-lg text-gray-500 max-w-3xl mx-auto font-normal">
      {subtitle}
    </p>
  )}
</div>
