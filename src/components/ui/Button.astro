---
interface Props {
  href?: string;
  variant?: 'header' | 'primary' | 'accent' | 'outline' | 'white-outline';
  class?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { href, variant = 'primary', class: className = '', id, type } = Astro.props;

const baseStyles = "inline-flex justify-center items-center gap-2 rounded-full font-semibold transition-all duration-300 border-2";
const variants = {
  header: "bg-[var(--color-primary)] border-[var(--color-primary)] text-white hover:bg-transparent hover:text-[var(--color-primary)]",
  primary: "bg-transparent border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white",
  accent: "bg-[var(--color-accent)] border-[var(--color-accent)] text-gray-900 hover:bg-[#e6a500] hover:border-[#e6a500] shadow-[0_4px_14px_rgba(255,183,0,0.3)]",
  outline: "bg-transparent border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white",
  'white-outline': "bg-transparent border-white text-white hover:bg-white hover:text-[var(--color-primary)]"
};

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={`${baseStyles} ${variants[variant]} ${className}`} id={id} type={!href ? type : undefined}>
  <slot />
</Tag>
