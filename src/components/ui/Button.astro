---
interface Props {
  href?: string;
  variant?: 'primary' | 'accent' | 'outline' | 'white-outline';
  class?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { href, variant = 'primary', class: className = '', id, type } = Astro.props;

const baseStyles = "inline-flex justify-center items-center gap-2 rounded-lg font-semibold transition-all";
const variants = {
  primary: "bg-primary hover:bg-primary-dark text-white px-7 py-3.5 shadow-md hover:shadow-lg hover:scale-[1.02]",
  accent: "bg-accent hover:bg-accent-dark text-gray-900 px-8 py-3.5 font-bold shadow-[0_4px_14px_rgba(255,183,0,0.3)]",
  outline: "bg-transparent border-2 border-primary text-primary hover:bg-primary hover:text-white px-6 py-3",
  'white-outline': "bg-transparent border-2 border-white text-white hover:bg-white hover:text-primary px-6 py-3"
};

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={`${baseStyles} ${variants[variant]} ${className}`} id={id} type={!href ? type : undefined}>
  <slot />
</Tag>
