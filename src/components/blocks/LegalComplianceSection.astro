---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
---

<section class="py-24 bg-gray-900 overflow-hidden relative">
  <!-- Decoración de fondo -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-dark/20 to-transparent pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-6 md:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      
      <!-- Texto Izquierda -->
      <div class="w-full lg:w-[55%] flex flex-col items-start">
        <Badge variant="success" class="mb-6">✓ Cumplimiento 100% legal</Badge>
        
        <h2 class="text-[28px] md:text-[40px] font-bold text-white mb-6">
          Te ayudamos a cumplir la nueva Ley de Atención al Cliente
        </h2>
        
        <p class="text-lg text-gray-200 leading-relaxed mb-8">
          La normativa exige que las llamadas de información o postventa sean atendidas en menos de 3 minutos y que el usuario siempre tenga la opción de solicitar una interacción humana. Con LlamadaAtendida garantizas el cumplimiento estricto de la ley.
        </p>
        
        <ul class="flex flex-col gap-4 mb-10 w-full">
          <li class="flex items-start gap-3 animate-slide-right opacity-0" data-intersect>
            <svg class="w-6 h-6 text-success shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span class="text-gray-200">Atención general, información y postventa atendidas en 3 minutos o menos.</span>
          </li>
          <li class="flex items-start gap-3 animate-slide-right [animation-delay:100ms] opacity-0" data-intersect>
            <svg class="w-6 h-6 text-success shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span class="text-gray-200">Las reclamaciones se resuelven en un plazo máximo de 15 días.</span>
          </li>
          <li class="flex items-start gap-3 animate-slide-right [animation-delay:200ms] opacity-0" data-intersect>
            <svg class="w-6 h-6 text-success shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span class="text-gray-200">Empresas con servicio continuo: atención 24 horas, 7 días a la semana.</span>
          </li>
          <li class="flex items-start gap-3 animate-slide-right [animation-delay:300ms] opacity-0" data-intersect>
            <svg class="w-6 h-6 text-success shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span class="text-gray-200">Llamadas gratuitas: prohibida la transferencia a números de pago.</span>
          </li>
        </ul>
        
        <Button href="/nueva-ley" variant="white-outline">Saber más sobre la nueva ley</Button>
      </div>
      
      <!-- Imagen / Ilustración Derecha -->
      <div class="w-full lg:w-[45%] flex justify-center animate-slide-left opacity-0" data-intersect>
        <div class="relative w-full max-w-md aspect-square bg-gray-800 rounded-3xl border border-gray-700 flex items-center justify-center p-8 overflow-hidden">
           <!-- Decoraciones SVG abstractas simulando escudo/ley -->
           <svg class="w-full h-full text-primary opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
           </svg>
           <span class="absolute text-gray-400">Ilustración Escudo</span>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('[animation-fill-mode:forwards]');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('[data-intersect]').forEach((el) => observer.observe(el));
</script>
