---
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    
    <SectionHeader 
      title="Clientes felices, negocios que crecen"
      subtitle="Empresas de sectores muy diferentes ya confían en nosotros para cuidar a sus clientes."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Testimonial 1 -->
      <Card class="flex flex-col items-center text-center animate-slide-up opacity-0" data-intersect>
        <div class="relative w-full flex justify-center mb-6 pt-4">
          <div class="absolute top-0 left-0 text-primary/20">
            <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path></svg>
          </div>
          <img src="/images/testimonial-carlos.jpg" alt="Carlos - Empresa de reformas" class="w-20 h-20 rounded-full object-cover border-4 border-primary/20" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
          <div class="w-20 h-20 rounded-full bg-gray-200 border-4 border-primary/20 hidden items-center justify-center text-xl font-bold text-gray-500">C</div>
        </div>
        <p class="italic text-gray-700 leading-relaxed mb-6 flex-grow">"Su atención al cliente es de lo mejor. Mis clientes están contentos y siempre me solucionan cualquier duda o problema que tenga."</p>
        <div class="flex flex-col items-center">
          <h4 class="font-bold text-gray-900">Carlos</h4>
          <span class="text-sm text-gray-500 mb-2">Empresa de reformas</span>
          <div class="flex text-accent">
            {'★★★★★'.split('').map(star => <span>{star}</span>)}
          </div>
        </div>
      </Card>

      <!-- Testimonial 2 -->
      <Card class="flex flex-col items-center text-center animate-slide-up [animation-delay:150ms] opacity-0" data-intersect>
        <div class="relative w-full flex justify-center mb-6 pt-4">
          <div class="absolute top-0 left-0 text-primary/20">
            <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path></svg>
          </div>
          <img src="/images/testimonial-laura.jpg" alt="Laura - Dueña de peluquería" class="w-20 h-20 rounded-full object-cover border-4 border-primary/20" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
          <div class="w-20 h-20 rounded-full bg-gray-200 border-4 border-primary/20 hidden items-center justify-center text-xl font-bold text-gray-500">L</div>
        </div>
        <p class="italic text-gray-700 leading-relaxed mb-6 flex-grow">"Siempre están dispuestos a ayudar. Me han facilitado mucho el trabajo con las llamadas y puedo dedicarme a otras cosas del negocio."</p>
        <div class="flex flex-col items-center">
          <h4 class="font-bold text-gray-900">Laura</h4>
          <span class="text-sm text-gray-500 mb-2">Dueña de peluquería</span>
          <div class="flex text-accent">
            {'★★★★★'.split('').map(star => <span>{star}</span>)}
          </div>
        </div>
      </Card>

      <!-- Testimonial 3 -->
      <Card class="flex flex-col items-center text-center animate-slide-up [animation-delay:300ms] opacity-0" data-intersect>
        <div class="relative w-full flex justify-center mb-6 pt-4">
          <div class="absolute top-0 left-0 text-primary/20">
            <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path></svg>
          </div>
          <img src="/images/testimonial-david.jpg" alt="David - Agencia de viajes" class="w-20 h-20 rounded-full object-cover border-4 border-primary/20" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
          <div class="w-20 h-20 rounded-full bg-gray-200 border-4 border-primary/20 hidden items-center justify-center text-xl font-bold text-gray-500">D</div>
        </div>
        <p class="italic text-gray-700 leading-relaxed mb-6 flex-grow">"Mis clientes me han manifestado que los que les atendieron fueron muy profesionales y ayudaron con todo lo que necesitaban."</p>
        <div class="flex flex-col items-center">
          <h4 class="font-bold text-gray-900">David</h4>
          <span class="text-sm text-gray-500 mb-2">Agencia de viajes</span>
          <div class="flex text-accent">
            {'★★★★★'.split('').map(star => <span>{star}</span>)}
          </div>
        </div>
      </Card>

    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('[animation-fill-mode:forwards]');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('[data-intersect]').forEach((el) => observer.observe(el));
</script>
