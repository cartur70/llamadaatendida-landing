---
import ContactForm from './ContactForm.astro';
---

<section class="py-24 relative overflow-hidden bg-gradient-to-b from-primary to-primary-dark">
  <!-- Decoración de fondo -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden opacity-10 pointer-events-none">
    <div class="absolute -top-[20%] -left-[10%] w-[50%] pt-[50%] rounded-full bg-white blur-[100px]"></div>
    <div class="absolute -bottom-[20%] -right-[10%] w-[50%] pt-[50%] rounded-full bg-accent blur-[100px]"></div>
  </div>

  <div class="max-w-[800px] mx-auto px-6 md:px-8 relative z-10">
    <div class="text-center mb-12 animate-slide-up opacity-0" data-intersect>
      <h2 class="text-[32px] md:text-[48px] font-extrabold text-white leading-[1.1] mb-6">
        No pierdas ni una llamada (ni una venta) más.
      </h2>
      <p class="text-lg text-white/80 max-w-[600px] mx-auto">
        Únete a las empresas que ya han optimizado su comunicación y reducido sus costes fijos.
      </p>
    </div>

    <div class="animate-slide-up [animation-delay:200ms] opacity-0" data-intersect>
      <ContactForm />
      
      <p class="text-sm text-white/60 text-center mt-6">
        Sin compromiso. Cancela cuando quieras. Atención 24/7.
      </p>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('[animation-fill-mode:forwards]');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('[data-intersect]').forEach((el) => observer.observe(el));
</script>
