  <main class="pt-32 pb-24 min-h-screen">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <SectionHeader title="Nuestros Servicios" subtitle="Detalle ampliado de nuestros servicios de atención omnicanal." />
