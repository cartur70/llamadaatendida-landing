---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/blocks/Navbar.astro';
import Footer from '../components/blocks/Footer.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ContactForm from '../components/blocks/ContactForm.astro';
---
<Layout title="Contacto" description="Contacta con LlamadaAtendida">
  <Navbar />
  <main class="pt-32 pb-24 bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <SectionHeader title="Habla con un asesor" subtitle="Estamos aquí para ayudarte. Déjanos tus datos y te contactaremos a la brevedad." />
      <ContactForm />
    </div>
  </main>
  <Footer />
</Layout>
